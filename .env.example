# n8n webhook that receives contact form submissions (server only), i.e. the
# production URL of the "Support: Contact form" workflow
CONTACT_WEBHOOK_URL=
# Sent as the X-Webhook-Secret header (must match the n8n Header Auth credential)
# and used as the key for the IP hash n8n rate-limits on.
CONTACT_WEBHOOK_SECRET=
# Umami Cloud website ID; analytics stay off when empty.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Cloudflare Turnstile spam check for the contact form; off when empty.
# Cloudflare's always-passing test keys for local development:
# 1x00000000000000000000AA (site) / 1x0000000000000000000000000000000AA (secret)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
